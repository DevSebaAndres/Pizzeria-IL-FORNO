---
// src/components/ContactLocation.astro — Paso 10 del arco narrativo (Señales de confianza, NAP y Mapa interactivo)
import { business, waLink } from '../data/business';
const wa = waLink('Hola IL FORNO, quiero consultar la dirección y horarios');
const waRetiro = waLink('Hola IL FORNO, estoy cerca de San Luis y Lavalle, quiero avisar que paso a retirar');
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(business.address.street + ', ' + business.address.locality + ', Argentina')}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
---
<section id="contacto" aria-labelledby="contacto-heading" class="relative bg-[#F2EEE9] py-20 lg:py-28 text-[#161412] border-t border-[#E2DDD5]">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-12">
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-2xl mx-auto">
      <p class="font-sans text-xs font-bold uppercase tracking-[0.25em] text-fire-red">
        Datos verificados y atención directa
      </p>
      <h2 id="contacto-heading" class="font-display text-3xl sm:text-4xl lg:text-5xl uppercase tracking-wide text-[#161412] mt-2">
        Ubicación, Horarios y Contacto
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#5C554E]">
        Vení a visitarnos o hacé tu pedido por adelantado para retirar en nuestro local de San Miguel de Tucumán.
      </p>
    </div>

    <!-- Grilla de dos columnas principales -->
    <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <!-- Columna 1: Tarjetas de contacto (NAP enriquecidas con iconos y acciones) -->
      <div class="lg:col-span-6 space-y-6 flex flex-col justify-between">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Card 1: Dirección Local -->
          <div class="group relative rounded-3xl bg-white border border-[#E2DDD5] p-6 flex flex-col justify-between hover:border-fire-red/60 hover:-translate-y-1.5 transition-all duration-300 ease-out shadow-md hover:shadow-xl overflow-hidden">
            <!-- Glow top-border shimmer -->
            <div class="pointer-events-none absolute inset-x-0 -top-px h-1 bg-gradient-to-r from-transparent via-fire-red/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
            <!-- Subtle warm background glow -->
            <div class="pointer-events-none absolute inset-0 rounded-3xl bg-gradient-to-b from-fire-red/[0.03] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-fire-red">Dirección Local</span>
                <div class="h-9 w-9 rounded-xl bg-fire-red/10 border border-fire-red/25 flex items-center justify-center text-fire-red group-hover:scale-110 group-hover:bg-fire-red/20 group-hover:border-fire-red/50 transition-all duration-300">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
              </div>
              <h3 class="font-display text-xl uppercase text-[#161412] mt-3">{business.name}</h3>
              <p class="text-base font-semibold text-[#161412] mt-1">{business.address.street}</p>
              <p class="text-xs text-[#5C554E] mt-0.5">{business.address.locality}, {business.address.region}</p>
            </div>
            <div class="relative z-10 mt-5 pt-3 border-t border-[#E8E3DB]">
              <a
                href={business.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-fire-red hover:text-[#8F1D1D] transition-colors"
              >
                Abrir en Google Maps
                <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 2: Horarios de Atención -->
          <div class="group relative rounded-3xl bg-white border border-[#E2DDD5] p-6 flex flex-col justify-between hover:border-fire-red/60 hover:-translate-y-1.5 transition-all duration-300 ease-out shadow-md hover:shadow-xl overflow-hidden">
            <!-- Glow top-border shimmer -->
            <div class="pointer-events-none absolute inset-x-0 -top-px h-1 bg-gradient-to-r from-transparent via-fire-red/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
            <!-- Subtle warm background glow -->
            <div class="pointer-events-none absolute inset-0 rounded-3xl bg-gradient-to-b from-fire-red/[0.03] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-fire-red">Horarios</span>
                <div class="h-9 w-9 rounded-xl bg-fire-red/10 border border-fire-red/25 flex items-center justify-center text-fire-red group-hover:scale-110 group-hover:bg-fire-red/20 group-hover:border-fire-red/50 transition-all duration-300">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
              <h3 class="font-display text-xl uppercase text-[#161412] mt-3">Días y Horarios</h3>
              <ul class="mt-2 space-y-1.5 text-sm">
                {business.hoursText.map((h) => (
                  <li class="flex items-center justify-between text-[#161412]">
                    <span class="text-[#5C554E]">{h.days}:</span>
                    <span class="font-semibold text-xs sm:text-sm">{h.time}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="relative z-10 mt-5 pt-3 border-t border-[#E8E3DB]">
              <span class="text-[11px] text-[#5C554E] block">* Horario nocturno habitual</span>
            </div>
          </div>

          <!-- Card 3: Líneas de Pedido -->
          <div class="group relative rounded-3xl bg-white border border-[#E2DDD5] p-6 flex flex-col justify-between hover:border-fire-red/60 hover:-translate-y-1.5 transition-all duration-300 ease-out shadow-md hover:shadow-xl overflow-hidden">
            <!-- Glow top-border shimmer -->
            <div class="pointer-events-none absolute inset-x-0 -top-px h-1 bg-gradient-to-r from-transparent via-fire-red/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
            <!-- Subtle warm background glow -->
            <div class="pointer-events-none absolute inset-0 rounded-3xl bg-gradient-to-b from-fire-red/[0.03] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-fire-red">Pedidos</span>
                <div class="h-9 w-9 rounded-xl bg-fire-red/10 border border-fire-red/25 flex items-center justify-center text-fire-red group-hover:scale-110 group-hover:bg-fire-red/20 group-hover:border-fire-red/50 transition-all duration-300">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
              </div>
              <h3 class="font-display text-xl uppercase text-[#161412] mt-3">Teléfono y Mensajes</h3>
              <div class="mt-3 space-y-2 text-sm">
                <div>
                  <span class="text-xs text-[#5C554E] block">Llamadas directas:</span>
                  <a href={business.phoneTel} class="text-base font-bold text-[#161412] hover:text-fire-red transition-colors">
                    {business.phoneDisplay}
                  </a>
                </div>
                <div>
                  <span class="text-xs text-[#5C554E] block">WhatsApp de pedidos:</span>
                  <a href={wa} class="text-base font-bold text-fire-red hover:text-[#8F1D1D] transition-colors">
                    {business.whatsappDisplay}
                  </a>
                </div>
              </div>
            </div>
            <div class="relative z-10 mt-5 pt-3 border-t border-[#E8E3DB]">
              <a
                href={wa}
                class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-fire-red hover:text-[#8F1D1D] transition-colors"
              >
                Enviar WhatsApp ahora
                <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 4: Canales Digitales / Instagram -->
          <div class="group relative rounded-3xl bg-white border border-[#E2DDD5] p-6 flex flex-col justify-between hover:border-fire-red/60 hover:-translate-y-1.5 transition-all duration-300 ease-out shadow-md hover:shadow-xl overflow-hidden">
            <!-- Glow top-border shimmer -->
            <div class="pointer-events-none absolute inset-x-0 -top-px h-1 bg-gradient-to-r from-transparent via-fire-red/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
            <!-- Subtle warm background glow -->
            <div class="pointer-events-none absolute inset-0 rounded-3xl bg-gradient-to-b from-fire-red/[0.03] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-fire-red">Redes</span>
                <div class="h-9 w-9 rounded-xl bg-fire-red/10 border border-fire-red/25 flex items-center justify-center text-fire-red group-hover:scale-110 group-hover:bg-fire-red/20 group-hover:border-fire-red/50 transition-all duration-300">
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
                </div>
              </div>
              <h3 class="font-display text-xl uppercase text-[#161412] mt-3">Instagram Oficial</h3>
              <p class="text-sm text-[#5C554E] mt-1">Fotos del horno, novedades semanales y promociones del día.</p>
            </div>
            <div class="relative z-10 mt-5 pt-3 border-t border-[#E8E3DB]">
              <a
                href={business.instagram.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm font-bold text-fire-red hover:text-[#8F1D1D] transition-colors"
              >
                {business.instagram.handle}
                <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Banner de retiro rápido al paso -->
        <div class="group relative overflow-hidden rounded-3xl bg-white border border-[#E2DDD5] hover:border-fire-red/50 p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md hover:shadow-xl transition-all duration-300">
          <!-- Glow top-border shimmer -->
          <div class="pointer-events-none absolute inset-x-0 -top-px h-1 bg-gradient-to-r from-transparent via-fire-red/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

          <div class="relative z-10 flex items-center gap-4">
            <div class="h-10 w-10 shrink-0 rounded-full bg-fire-red/10 border border-fire-red/25 flex items-center justify-center text-fire-red group-hover:scale-110 transition-all duration-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <span class="font-bold text-[#161412] block text-sm sm:text-base">¿Estás cerca de calle San Luis y Lavalle?</span>
              <span class="text-[#5C554E] text-xs mt-0.5 block">Avisanos por WhatsApp y te dejamos la caja caliente lista en mostrador.</span>
            </div>
          </div>
          <a
            href={waRetiro}
            class="relative z-10 inline-flex h-[46px] shrink-0 items-center justify-center rounded-full bg-fire-red px-6 text-xs sm:text-sm font-bold uppercase tracking-wider text-white shadow-md shadow-fire-red/20 hover:bg-[#8F1D1D] hover:scale-[1.03] active:scale-[0.98] transition-all whitespace-nowrap"
          >
            Avisar que paso
          </a>
        </div>
      </div>

      <!-- Columna 2: Card "Mapa y Orientación" con mapa interactivo embebido -->
      <div class="group relative lg:col-span-6 rounded-3xl bg-white border border-[#E2DDD5] hover:border-fire-red/50 p-6 sm:p-8 flex flex-col justify-between shadow-xl hover:shadow-2xl transition-all duration-300 overflow-hidden">
        <!-- Accent glow line at top -->
        <div class="pointer-events-none absolute inset-x-0 -top-px h-1.5 bg-gradient-to-r from-fire-red/20 via-fire-red to-fire-red/20 opacity-70 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

        <div class="relative z-10">
          <!-- Cabecera de la card -->
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-fire-red">Mapa y Orientación</span>
            <span class="text-xs font-semibold text-[#8F5B1E] bg-[#FEF3C7] border border-[#FDE68A] px-3 py-1 rounded-full">
              San Luis 601 esq. Lavalle
            </span>
          </div>

          <h3 class="font-display text-2xl sm:text-3xl uppercase text-[#161412] mt-3">
            Cómo Llegar a IL FORNO
          </h3>
          <p class="text-sm text-[#5C554E] mt-1 leading-relaxed">
            Esquina céntrica y de fácil detención en San Miguel de Tucumán.
          </p>

          <!-- MAPA INTERACTIVO EMBEBIDO -->
          <div class="mt-5 relative w-full h-[260px] sm:h-[300px] rounded-2xl overflow-hidden border border-[#E2DDD5] bg-[#F8F6F2] shadow-inner transition-colors duration-300">
            <iframe
              src={mapEmbedUrl}
              title="Ubicación de IL FORNO Pizzería en San Luis 601, San Miguel de Tucumán"
              class="w-full h-full border-0 filter contrast-[1.05] opacity-95 group-hover:opacity-100 transition-opacity duration-300"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              aria-label="Mapa de Google con la ubicación de IL FORNO"
            ></iframe>
          </div>

          <!-- Puntos de referencia y orientación rápida -->
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="rounded-xl bg-[#F8F6F2] border border-[#E8E3DB] hover:border-fire-red/40 hover:bg-white p-3.5 flex items-start gap-2.5 transition-all duration-300 shadow-sm">
              <span class="text-fire-red text-base mt-0.5" aria-hidden="true">📍</span>
              <div>
                <strong class="text-[#161412] block">Punto de retiro:</strong>
                <span class="text-[#5C554E]">Fácil estacionamiento momentáneo en la esquina.</span>
              </div>
            </div>
            <div class="rounded-xl bg-[#F8F6F2] border border-[#E8E3DB] hover:border-fire-red/40 hover:bg-white p-3.5 flex items-start gap-2.5 transition-all duration-300 shadow-sm">
              <span class="text-fire-red text-base mt-0.5" aria-hidden="true">📞</span>
              <div>
                <strong class="text-[#161412] block">Llamanos al llegar:</strong>
                <span class="text-[#5C554E]">{business.phoneDisplay} para tener tu pedido en mano.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Botones de acción en Google Maps -->
        <div class="relative z-10 mt-6 pt-5 border-t border-[#E8E3DB] flex flex-wrap sm:flex-nowrap gap-3">
          <a
            href={business.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex h-[50px] items-center justify-center rounded-full bg-fire-red text-xs sm:text-sm font-bold uppercase tracking-wider text-white shadow-md shadow-fire-red/20 transition-all hover:bg-[#8F1D1D] hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-fire-red"
          >
            Ver en Google Maps
          </a>
          <a
            href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(business.address.street + ', ' + business.address.locality)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-[50px] px-6 items-center justify-center rounded-full border-2 border-[#D8D2C8] bg-white text-xs sm:text-sm font-bold uppercase tracking-wider text-[#161412] hover:border-fire-red hover:text-fire-red hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            Cómo llegar (GPS)
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
