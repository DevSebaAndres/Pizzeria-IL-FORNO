---
// src/components/Menu.astro — Paso 4 del arco narrativo (Carta oficial y precios reales)
// Fiel a la captura de Figma: Imágenes originales de la pala con queso y la pizza con corona
// flanqueando el botón central CTA, más las cenefas laterales de doble columna de puntos rojos y mini pizzas.
import { business, money, waLink } from '../data/business';
const { fresh, bake } = business.menu;
---
<section id="menu" aria-labelledby="menu-heading" class="relative bg-[#F2EEE9] py-20 lg:py-28 text-[#161412] border-t border-[#E2DDD5] overflow-hidden">
  
  <!-- Cenefa lateral izquierda decorativa (Doble columna de puntos y porciones de pizza fiel a Figma) -->
  <div class="hidden md:flex flex-col justify-between items-center absolute left-2 sm:left-4 xl:left-8 top-16 bottom-16 w-8 text-fire-red select-none pointer-events-none z-10" aria-hidden="true">
    {Array.from({ length: 18 }).map((_, idx) => (
      <div class="flex items-center justify-between w-full">
        <!-- Columna exterior: Puntos rojos intensos -->
        <span class="w-2 h-2 rounded-full bg-fire-red shadow-sm"></span>
        <!-- Columna interior: Alterna porción de pizza doodle y punto rojo -->
        {idx % 2 === 0 ? (
          <svg class="w-3.5 h-3.5 text-fire-red shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2 L22 20 Q 12 23 2 20 Z" />
            <circle cx="12" cy="11" r="2" fill="#F2EEE9" />
          </svg>
        ) : (
          <span class="w-2 h-2 rounded-full bg-fire-red shadow-sm"></span>
        )}
      </div>
    ))}
  </div>

  <!-- Cenefa lateral derecha decorativa (Doble columna de puntos y porciones de pizza fiel a Figma) -->
  <div class="hidden md:flex flex-col justify-between items-center absolute right-2 sm:right-4 xl:right-8 top-16 bottom-16 w-8 text-fire-red select-none pointer-events-none z-10" aria-hidden="true">
    {Array.from({ length: 18 }).map((_, idx) => (
      <div class="flex items-center justify-between w-full">
        {idx % 2 === 0 ? (
          <svg class="w-3.5 h-3.5 text-fire-red shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2 L22 20 Q 12 23 2 20 Z" />
            <circle cx="12" cy="11" r="2" fill="#F2EEE9" />
          </svg>
        ) : (
          <span class="w-2 h-2 rounded-full bg-fire-red shadow-sm"></span>
        )}
        <span class="w-2 h-2 rounded-full bg-fire-red shadow-sm"></span>
      </div>
    ))}
  </div>

  <div class="relative z-10 mx-auto max-w-[1280px] px-6 sm:px-10 lg:px-20">
    <!-- Encabezado de la sección con ilustración de porción volando y flecha curva (Figma) -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center relative">
      
      <!-- Flecha en espiral estilo Figma arriba a la derecha -->
      <div class="hidden md:block absolute -right-6 lg:-right-12 top-0 text-fire-red select-none pointer-events-none" aria-hidden="true">
        <svg class="w-16 h-14 text-fire-red" viewBox="0 0 80 60" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M68 6 C52 10, 36 24, 52 34 C64 40, 60 52, 28 50" />
          <path d="M34 42 L26 50 L34 56" />
        </svg>
      </div>

      <!-- Ilustración artesanal: Porción de pizza flotante con vapor -->
      <div class="inline-flex items-center justify-center text-fire-red mb-3" aria-hidden="true">
        <svg class="w-12 h-12 text-fire-red drop-shadow-[0_2px_12px_rgba(179,38,30,0.25)]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <!-- Porción triangular de pizza -->
          <path d="M14 22 Q 32 16, 50 22 L 32 56 Z" />
          <path d="M12 22 Q 32 27, 52 22" />
          <!-- Toppings / pepperoni y queso -->
          <circle cx="32" cy="31" r="3" fill="currentColor" />
          <circle cx="24" cy="40" r="2.5" fill="currentColor" />
          <circle cx="38" cy="42" r="2.5" fill="currentColor" />
          <!-- Líneas de vapor artesanal -->
          <path d="M26 13 Q 24 7, 28 4" stroke-width="2" />
          <path d="M34 12 Q 38 7, 35 3" stroke-width="2" />
          <path d="M42 13 Q 40 8, 44 4" stroke-width="2" />
        </svg>
      </div>

      
      <h2 id="menu-heading" class="font-display text-3xl sm:text-4xl lg:text-5xl uppercase tracking-wide text-[#161412] mt-2">
        Nuestra Carta y Promociones
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#5C554E]">
        Elegí tus pizzas listas para consumir al paso o para hornear en casa cuando quieras. Hacé tu pedido por teléfono o WhatsApp para tenerlo listo al llegar.
      </p>
    </div>

    <!-- Grilla de las 2 categorías principales en cards congruentes con el fondo #F2EEE9 -->
    <div class="mt-14 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Categoría 1: Recién salidas del horno (Opción Caliente) -->
      <div class="group relative rounded-3xl bg-white border border-[#E2DDD5] hover:border-fire-red/50 p-5 sm:p-8 flex flex-col justify-between shadow-xl hover:shadow-[0_20px_40px_-15px_rgba(179,38,30,0.18)] hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <!-- Resplandor superior cálido -->
        <div class="pointer-events-none absolute inset-x-0 -top-px h-1.5 bg-gradient-to-r from-fire-red/20 via-fire-red to-fire-red/20 opacity-70 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

        <!-- Ilustración original en la card como marca de agua -->
        <div class="absolute -right-4 -bottom-4 sm:-right-6 sm:-bottom-6 w-32 h-32 sm:w-40 sm:h-40 opacity-15 group-hover:opacity-30 transition-opacity duration-300 pointer-events-none select-none" aria-hidden="true">
          <img
            src="/illustration-whole-pizza-crown.webp"
            alt=""
            width="604"
            height="405"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>

        <div class="relative z-10">
          <div class="flex items-center justify-between border-b border-[#E8E3DB] pb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-fire-red">Opción Caliente</span>
              <h3 class="font-display text-2xl sm:text-3xl uppercase text-[#161412] mt-1">Recién Salidas del Horno</h3>
            </div>
            <span class="rounded-full bg-fire-red/10 px-3.5 py-1 text-xs font-semibold text-fire-red border border-fire-red/30">
              Con gaseosa incluida
            </span>
          </div>

          <ul class="mt-6 space-y-4">
            {fresh.map((item) => (
              <li class="group/item rounded-2xl bg-[#F8F6F2] p-4 sm:p-5 border border-[#E8E3DB] hover:border-fire-red/40 hover:bg-white hover:shadow-md transition-all duration-300">
                <div class="flex flex-col gap-2">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-fire-red bg-fire-red/10 px-2 py-0.5 rounded border border-fire-red/20">
                      {item.badge}
                    </span>
                  </div>

                  <!-- Línea de plato flexible y adaptada a móvil (sin desbordamiento de precios) -->
                  <div class="flex items-start sm:items-baseline justify-between gap-2 sm:gap-3 mt-1">
                    <h4 class="font-sans text-base sm:text-lg font-bold text-[#161412] min-w-0 flex-1 leading-snug break-words">
                      {item.name}
                    </h4>
                    <span class="hidden sm:block flex-1 border-b-2 border-dotted border-[#D8D2C8] group-hover/item:border-fire-red/40 transition-colors mx-1 mb-1" aria-hidden="true"></span>
                    <span class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-fire-red shrink-0 text-right">
                      {money(item.price)}
                    </span>
                  </div>

                  <p class="text-sm text-[#5C554E] mt-0.5 leading-relaxed">{item.description}</p>
                </div>

                <div class="mt-4 pt-3 border-t border-[#E8E3DB] flex justify-end">
                  <a
                    href={waLink(`Hola IL FORNO, quiero pedir el combo: ${item.name}`)}
                    class="text-xs font-bold uppercase tracking-wider text-fire-red hover:text-[#8F1D1D] flex items-center gap-1.5 transition-colors"
                  >
                    Pedir este combo
                    <span class="inline-block transition-transform duration-200 group-hover/item:translate-x-1" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Categoría 2: Para hornear en casa (Para Llevar) -->
      <div class="group relative rounded-3xl bg-white border border-[#E2DDD5] hover:border-[#D97706]/50 p-5 sm:p-8 flex flex-col justify-between shadow-xl hover:shadow-[0_20px_40px_-15px_rgba(217,119,6,0.18)] hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <!-- Resplandor superior masa dorada -->
        <div class="pointer-events-none absolute inset-x-0 -top-px h-1.5 bg-gradient-to-r from-amber-500/20 via-[#D97706]/60 to-amber-500/20 opacity-70 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

        <!-- Ilustración original en la card como marca de agua -->
        <div class="absolute -left-4 -bottom-4 sm:-left-6 sm:-bottom-6 w-36 h-32 sm:w-44 sm:h-36 opacity-15 group-hover:opacity-30 transition-opacity duration-300 pointer-events-none select-none" aria-hidden="true">
          <img
            src="/illustration-paddle-cheese.webp"
            alt=""
            width="418"
            height="304"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>

        <div class="relative z-10">
          <div class="flex items-center justify-between border-b border-[#E8E3DB] pb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#945300]">Para Llevar</span>
              <h3 class="font-display text-2xl sm:text-3xl uppercase text-[#161412] mt-1">Para Hornear en Casa</h3>
            </div>
            <span class="rounded-full bg-[#FEF3C7] px-3.5 py-1 text-xs font-semibold text-[#92400E] border border-[#FDE68A]">
              Promos x3 unidades
            </span>
          </div>

          <ul class="mt-6 space-y-4">
            {bake.map((item) => (
              <li class="group/item rounded-2xl bg-[#F8F6F2] p-4 sm:p-5 border border-[#E8E3DB] hover:border-[#D97706]/40 hover:bg-white hover:shadow-md transition-all duration-300">
                <div class="flex flex-col gap-2">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-[#92400E] bg-[#FEF3C7] px-2 py-0.5 rounded border border-[#FDE68A]">
                      {item.badge}
                    </span>
                  </div>

                  <!-- Línea de plato flexible y adaptada a móvil (sin desbordamiento de precios) -->
                  <div class="flex items-start sm:items-baseline justify-between gap-2 sm:gap-3 mt-1">
                    <h4 class="font-sans text-base sm:text-lg font-bold text-[#161412] min-w-0 flex-1 leading-snug break-words">
                      {item.name}
                    </h4>
                    <span class="hidden sm:block flex-1 border-b-2 border-dotted border-[#D8D2C8] group-hover/item:border-[#D97706]/40 transition-colors mx-1 mb-1" aria-hidden="true"></span>
                    <span class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-[#945300] shrink-0 text-right">
                      {money(item.price)}
                    </span>
                  </div>

                  <p class="text-sm text-[#5C554E] mt-0.5 leading-relaxed">{item.description}</p>
                </div>

                <div class="mt-4 pt-3 border-t border-[#E8E3DB] flex justify-end">
                  <a
                    href={waLink(`Hola IL FORNO, quiero encargar: ${item.name}`)}
                    class="text-xs font-bold uppercase tracking-wider text-[#945300] hover:text-fire-red flex items-center gap-1.5 transition-colors"
                  >
                    Encargar esta pizza
                    <span class="inline-block transition-transform duration-200 group-hover/item:translate-x-1" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- ZONA INFERIOR DEL MENÚ (Fiel a la captura de pantalla del usuario:        -->
    <!-- Pala con queso a la izquierda (imagen original), Botón CTA al centro,     -->
    <!-- Pizza entera con corona a la derecha (imagen original)                    -->
    <!-- ========================================================================= -->
    <div class="mt-16 pt-6 flex flex-col md:flex-row items-center justify-between gap-6 sm:gap-8 max-w-[1100px] mx-auto relative z-10">
      
      <!-- Ilustración Izquierda: Pala pizzera con porción y queso suizo (Imagen original fiel a la captura) -->
      <div class="flex items-center gap-4 select-none order-2 md:order-1">
        <img
          src="/illustration-paddle-cheese.webp"
          alt="Ilustración artesanal de pala pizzera con porción de pizza y queso suizo"
          width="418"
          height="304"
          class="w-32 sm:w-40 lg:w-48 h-auto object-contain drop-shadow-sm transform hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
        <div class="hidden sm:block text-left text-xs text-[#5C554E]">
          <p class="font-bold text-[#161412] uppercase tracking-wider">Masa Artesanal</p>
          <p class="text-[11px] text-[#5C554E]">Fermentación cuidada</p>
        </div>
      </div>

      <!-- Centro: Botón de llamada a la acción rojo y disclaimer (Figma: ORDER NOW) -->
      <div class="flex flex-col items-center text-center order-1 md:order-2">
        <a
          href={waLink('Hola IL FORNO, quiero hacer mi pedido de la carta')}
          class="inline-flex h-[52px] sm:h-[56px] items-center justify-center rounded-full bg-fire-red px-8 sm:px-10 text-sm sm:text-base font-bold uppercase tracking-wider text-white shadow-lg shadow-fire-red/25 transition-all hover:bg-[#8F1D1D] hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fire-red"
        >
          Hacé tu pedido por WhatsApp
          <span class="ml-2 font-mono text-lg" aria-hidden="true">&rarr;</span>
        </a>
        <p class="mt-2.5 text-[11px] sm:text-xs text-[#5C554E]">
          * Ofertas válidas para retiro en local y pedidos por WhatsApp.
        </p>
      </div>

      <!-- Ilustración Derecha: Pizza entera cortada con corona (Imagen original fiel a la captura) -->
      <div class="flex items-center justify-end gap-4 select-none order-3">
        <div class="hidden sm:block text-right text-xs text-[#5C554E]">
          <p class="font-bold text-[#161412] uppercase tracking-wider">Calidad de Horno</p>
          <p class="text-[11px] text-[#5C554E]">Recién horneada</p>
        </div>
        <img
          src="/illustration-whole-pizza-crown.webp"
          alt="Ilustración artesanal de pizza entera con corona"
          width="604"
          height="405"
          class="w-36 sm:w-44 lg:w-52 h-auto object-contain drop-shadow-sm transform hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      </div>

    </div>

  </div>
</section>
