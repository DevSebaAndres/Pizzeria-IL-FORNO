---
/*
  Hero — IL FORNO Pizzería
  Navbar reestructurada:
    1. Logo (primer elemento)
    2. Menú
    3. Cómo funciona
    4. Por qué elegirnos
    5. Preguntas frecuentes
    6. Contacto
    7. Botón CTA: "Quiero hacer mi pedido"
  Diseño responsivo sin desbordamientos ni colisiones.
*/
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-pizza.webp';
import { business, waLink, entityStatement } from '../data/business';

const nav = [
  { label: 'Menú', href: '#menu' },
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Por qué elegirnos', href: '#diferenciales' },
  { label: 'Preguntas frecuentes', href: '#faq' },
  { label: 'Contacto', href: '#contacto' },
];
const wa = waLink('Hola IL FORNO, quiero hacer mi pedido.');
const info = [
  { label: 'Horario', value: `${business.hoursText[0].days} · ${business.hoursText[0].time}` },
  { label: 'Ubicación', value: business.address.street, href: '#contacto' },
  { label: 'Instagram', value: business.instagram.handle, href: business.instagram.href },
];
---
<header id="inicio" class="relative">
  <!-- Barra superior informativa (Fiel al diseño original de Figma) -->
  <div class="w-full bg-fire-red text-cream font-sans border-b border-black/10 py-1.5 lg:h-[37px] lg:py-0 flex items-center">
    <div class="mx-auto flex w-full max-w-[1920px] items-center justify-between px-6 lg:px-[100px] xl:px-[140px] text-[11px] sm:text-xs">
      <!-- Datos informativos del negocio a la izquierda -->
      <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
        <!-- Dirección / Ubicación -->
        <a
          href={business.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-cream/90 hover:text-ember transition-colors max-w-[190px] sm:max-w-none truncate"
          title="Ver ubicación en Google Maps"
        >
          <svg class="h-3.5 w-3.5 text-ember shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="font-medium tracking-wide truncate">
            {business.address.street}<span class="hidden sm:inline">, {business.address.locality}</span>
          </span>
        </a>

        <!-- Teléfono de pedidos -->
        <a
          href={business.phoneTel}
          class="flex items-center gap-1.5 text-cream/90 hover:text-ember transition-colors"
          title="Llamar a IL FORNO"
        >
          <svg class="h-3.5 w-3.5 text-ember shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="font-semibold tracking-wide">
            {business.phoneDisplay}
          </span>
        </a>
      </div>

      <!-- Botones de Redes Sociales a la derecha (Facebook, Instagram, WhatsApp, YouTube) -->
      <div class="flex items-center gap-3 sm:gap-3.5 shrink-0 ml-4">
        <!-- Facebook -->
        <a
          href="https://facebook.com/ilforno.pizzeria"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream/90 hover:text-ember hover:scale-110 transition-all p-0.5"
          aria-label="Seguir a IL FORNO en Facebook"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href={business.instagram.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream/90 hover:text-ember hover:scale-110 transition-all p-0.5"
          aria-label="Seguir a IL FORNO en Instagram"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>

        <!-- WhatsApp -->
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream/90 hover:text-ember hover:scale-110 transition-all p-0.5"
          aria-label="Contactar a IL FORNO por WhatsApp"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
          </svg>
        </a>

        <!-- YouTube -->
        <a
          href="https://youtube.com/@ilforno.pizzeria"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream/90 hover:text-ember hover:scale-110 transition-all p-0.5"
          aria-label="Ver videos de IL FORNO en YouTube"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Hero principal -->
  <div class="relative min-h-[700px] overflow-hidden bg-coal-2 lg:h-[954px]">
    <!-- Imagen de fondo optimizada con fetchpriority="high" como candidato LCP -->
    <Image
      src={heroImg}
      alt="Pizza artesanal de pepperoni con masa crocante recién salida del horno de leña en IL FORNO"
      widths={[800, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-right"
    />
    <!-- Degradados para contraste y legibilidad impecable -->
    <div class="absolute inset-y-0 left-0 w-full bg-gradient-to-r from-coal via-coal/85 to-transparent lg:w-[780px] lg:via-coal/65" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-coal via-transparent to-black/30" aria-hidden="true"></div>

    <div class="relative mx-auto flex h-full w-full max-w-[1920px] flex-col px-6 lg:px-[100px] xl:px-[140px]">
      <!-- Barra de navegación principal -->
      <nav aria-label="Navegación principal" class="mt-4 sm:mt-8 relative z-30">
        <!-- Fila principal de navegación -->
        <div class="flex items-center justify-between gap-3">
          <!-- 1. Logo (primer elemento a la izquierda) -->
          <a
            href="#inicio"
            class="flex items-center gap-2.5 sm:gap-3 shrink-0 group focus-visible:outline-2 focus-visible:outline-fire-orange rounded-lg"
            aria-label="IL FORNO Pizzería, volver al inicio"
          >
            <img
              src="/logo-ilforno.webp"
              alt="Logo Horno a Leña IL FORNO"
              width="56"
              height="43"
              class="h-9 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105"
              loading="eager"
            />
            <div class="flex flex-col">
              <span class="font-display text-lg sm:text-2xl uppercase tracking-wider text-ember leading-none group-hover:text-fire-orange transition-colors">
                IL FORNO
              </span>
              <span class="font-sans text-[9px] sm:text-[10px] uppercase tracking-[0.25em] text-ash leading-tight">
                Pizzería
              </span>
            </div>
          </a>

          <!-- Enlaces de navegación (desktop): Menú, Cómo funciona, Por qué elegirnos, Preguntas frecuentes, Contacto -->
          <ul class="hidden lg:flex items-center gap-4 xl:gap-7 text-sm font-semibold tracking-wide">
            {nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="text-cream/90 hover:text-fire-orange transition-colors focus-visible:outline-2 focus-visible:outline-fire-orange whitespace-nowrap py-1"
                >
                  {n.label}
                </a>
              </li>
            ))}
          </ul>

          <!-- Botón CTA (desktop) -->
          <div class="hidden lg:flex items-center gap-3 shrink-0">
            <a
              href={wa}
              class="inline-flex h-[48px] items-center justify-center rounded-btn bg-fire-orange px-6 text-sm font-bold uppercase tracking-wider text-coal transition-all hover:bg-ember hover:shadow-lg hover:shadow-fire-orange/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ember whitespace-nowrap"
            >
              Quiero hacer mi pedido
            </a>
          </div>

          <!-- Navegación móvil y tablet: Botón CTA compacto + Acordeón desplegable (Zero JS) -->
          <div class="flex lg:hidden items-center gap-2">
            <!-- Botón de pedido móvil directo -->
            <a
              href={wa}
              class="inline-flex h-[38px] items-center justify-center rounded-btn bg-fire-orange px-3.5 text-xs font-bold uppercase tracking-wider text-coal transition-all hover:bg-ember whitespace-nowrap"
            >
              Pedir
            </a>

            <!-- Acordeón de navegación móvil (Zero JS) -->
            <div class="relative">
              <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" aria-label="Abrir menú de navegación" />

              <label
                for="mobile-menu-toggle"
                class="flex h-[38px] px-3 items-center justify-center gap-1.5 rounded-xl border border-coal-3 bg-coal/90 text-cream hover:border-fire-orange cursor-pointer transition-colors peer-checked:border-fire-orange peer-checked:bg-coal select-none"
              >
                <!-- Icono de hamburguesa cuando está cerrado -->
                <svg class="h-5 w-5 text-fire-orange block [[id='mobile-menu-toggle']:checked~label_&]:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <!-- Icono de cerrar (X) cuando está abierto -->
                <svg class="h-5 w-5 text-fire-orange hidden [[id='mobile-menu-toggle']:checked~label_&]:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span class="text-xs font-bold uppercase tracking-wider block [[id='mobile-menu-toggle']:checked~label_&]:hidden">Menú</span>
                <span class="text-xs font-bold uppercase tracking-wider hidden [[id='mobile-menu-toggle']:checked~label_&]:inline">Cerrar</span>
              </label>

              <!-- Panel desplegable tipo acordeón -->
              <div class="hidden peer-checked:flex absolute right-0 top-full mt-2 w-[calc(100vw-3rem)] max-w-[280px] rounded-2xl border border-coal-3 bg-coal-2/95 backdrop-blur-xl p-4 shadow-2xl z-50 flex-col gap-2">
                <p class="text-[10px] font-bold uppercase tracking-widest text-fire-orange px-2 pb-1 border-b border-coal-3">
                  Navegación
                </p>
                <ul class="flex flex-col text-sm font-semibold">
                  {nav.map((n) => (
                    <li>
                      <a
                        href={n.href}
                        class="flex items-center justify-between py-2.5 px-2 rounded-lg text-cream hover:bg-coal-3 hover:text-fire-orange transition-colors"
                        onclick="document.getElementById('mobile-menu-toggle').checked = false"
                      >
                        <span>{n.label}</span>
                        <span class="text-xs text-ash" aria-hidden="true">&rarr;</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="pt-2 border-t border-coal-3">
                  <a
                    href={wa}
                    class="flex h-[42px] w-full items-center justify-center rounded-btn bg-fire-orange text-xs font-bold uppercase tracking-wider text-coal hover:bg-ember transition-colors"
                  >
                    Quiero hacer mi pedido
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- Bloque de contenido editorial y conversión -->
      <div class="my-auto max-w-[720px] pb-24 pt-12 lg:mt-[180px] lg:pb-0">
        <div class="inline-flex items-center gap-2 rounded-full border border-fire-orange/40 bg-coal/80 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-fire-orange backdrop-blur-sm">
          <span class="inline-block h-2 w-2 rounded-full bg-fire-orange animate-pulse" aria-hidden="true"></span>
          Horno a leña · Sabor artesanal
        </div>

        <h1 class="mt-4 font-display text-[clamp(2.5rem,5.5vw,4.5rem)] uppercase leading-[0.98] text-cream">
          Pizzas recién salidas del horno <span class="block text-xl sm:text-2xl lg:text-3xl font-sans font-bold tracking-normal text-fire-orange mt-2">en San Miguel de Tucumán</span>
        </h1>

        <!-- Frase de entidad AEO visible y citable por buscadores con IA -->
        <p class="mt-5 max-w-[580px] text-base leading-relaxed text-cream/90">
          {entityStatement}
        </p>

        <!-- Acciones primarias -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={wa}
            class="inline-flex h-[59px] w-full sm:w-[246px] items-center justify-center rounded-btn bg-fire-orange text-base font-semibold uppercase leading-6 text-coal transition-all hover:bg-ember hover:shadow-lg hover:shadow-fire-orange/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ember"
          >
            Quiero hacer mi pedido
          </a>
          <a
            href={business.phoneTel}
            class="inline-flex h-[59px] w-full sm:w-[246px] items-center justify-center rounded-btn border border-ash/40 bg-coal/60 text-base font-semibold uppercase leading-6 text-cream backdrop-blur-sm transition-colors hover:border-fire-orange hover:text-fire-orange focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fire-orange"
          >
            Llamar al local
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Banda inferior de datos rápidos (Pill horizontal con ilustraciones artesanales) -->
  <div class="relative w-full bg-fire-red px-6 py-8 lg:h-[220px] lg:px-[60px] xl:px-[100px] 2xl:px-[140px] lg:py-0 overflow-hidden">
    <!-- Ilustración 1: Corona hand-drawn a la izquierda (fiel a la captura del diseño) -->
    <div class="hidden lg:flex items-center justify-center absolute left-4 xl:left-8 2xl:left-14 top-1/2 lg:top-[50px] text-ember pointer-events-none select-none z-10" aria-hidden="true">
      <svg class="w-16 h-16 xl:w-20 xl:h-20 drop-shadow-[0_2px_8px_rgba(0,0,0,0.3)] transform -rotate-12 opacity-90" viewBox="0 0 80 75" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <!-- Corona doodle de 3 picos con base arqueada -->
        <path d="M12 55 L20 22 L38 38 L52 14 L62 38 L74 24 L68 56 Z" />
        <path d="M14 62 C 32 67, 48 67, 66 62" />
        <!-- Puntos/esferas en las puntas de la corona -->
        <circle cx="20" cy="20" r="3" fill="currentColor" />
        <circle cx="52" cy="12" r="3" fill="currentColor" />
        <circle cx="74" cy="22" r="3" fill="currentColor" />
      </svg>
    </div>

    <!-- Pill horizontal central (Fondo claro blanco fiel a la segunda captura de Figma) -->
    <div class="mx-auto flex max-w-[1532px] flex-col items-stretch gap-6 rounded-[28px] bg-white px-6 sm:px-8 py-6 shadow-[0_16px_40px_-10px_rgba(0,0,0,0.35)] lg:relative lg:top-[55px] lg:h-[125px] lg:flex-row lg:items-center lg:justify-between lg:rounded-pill lg:px-[80px] lg:py-0 relative z-20">
      <!-- Bloque 1: Horario con icono -->
      <div class="flex-1 border-b border-[#E8E3DB] pb-3 lg:border-b-0 lg:pb-0">
        <p class="text-xs font-bold uppercase tracking-wider text-fire-red flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-fire-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Horario
        </p>
        <p class="mt-1.5 text-sm sm:text-base font-semibold leading-snug text-[#161412] border-b border-[#D8D2C8] pb-1 max-w-[240px]">
          {business.hoursText[0].days} · {business.hoursText[0].time}
        </p>
      </div>

      <!-- Bloque 2: Ubicación con icono -->
      <div class="flex-1 border-b border-[#E8E3DB] pb-3 lg:border-b-0 lg:pb-0">
        <p class="text-xs font-bold uppercase tracking-wider text-fire-red flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-fire-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Ubicación
        </p>
        <a href="#contacto" class="mt-1.5 block text-sm sm:text-base font-semibold leading-snug text-[#161412] hover:text-fire-red transition-colors border-b border-[#D8D2C8] pb-1 max-w-[200px]">
          {business.address.street}
        </a>
      </div>

      <!-- Bloque 3: Instagram con icono -->
      <div class="flex-1 border-b border-[#E8E3DB] pb-3 lg:border-b-0 lg:pb-0">
        <p class="text-xs font-bold uppercase tracking-wider text-fire-red flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5 text-fire-red shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
